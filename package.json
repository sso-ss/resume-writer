    ".github/skills/resume-review/scripts/review_app.py",
    ".github/skills/resume-writing/SKILL.md",
    ".github/skills/resume-writing/references/",
    ".github/skills/resume-writing/templates/",
    ".github/skills/resume-writing/requirements-pdf.txt",
