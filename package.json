  "description": "Review resumes against jobs and preview editable resumes with Word and PDF exports. Python setup is automatic.",
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "resume-writer": "bin/resume-writer.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sso-ss/resume-writer.git"
  },
  "homepage": "https://github.com/sso-ss/resume-writer#readme",
  "bugs": "https://github.com/sso-ss/resume-writer/issues",
